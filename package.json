{
  "name": "paper-pilot",
  "version": "0.0.0-development",
  "description": "A local-first Electron research assistant for crawling papers and generating AI-backed scientific insights.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "verify:platform": "npm run typecheck && npm test && npm run build",
    "test:crawlers": "cross-env PAPER_PILOT_LIVE_CRAWLER_SMOKE=1 PAPER_PILOT_BROWSER_SMOKE=1 vitest run tests/crawler-smoke.test.ts --testTimeout=240000",
    "test:crawlers:api": "cross-env PAPER_PILOT_LIVE_CRAWLER_SMOKE=1 vitest run tests/crawler-smoke.test.ts --testTimeout=120000",
    "test:crawlers:browser": "cross-env PAPER_PILOT_BROWSER_SMOKE=1 vitest run tests/crawler-smoke.test.ts --testTimeout=240000",
    "start": "electron .",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.3.2",
    "framer-motion": "^12.23.24",
    "jotai": "^2.15.1",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.0.16",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.16",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
