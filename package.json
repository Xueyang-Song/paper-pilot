{
  "name": "paper-pilot",
  "version": "0.2.1",
  "description": "A local-first Electron research assistant for crawling papers and generating AI-backed scientific insights.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:crawlers": "cross-env PAPER_PILOT_LIVE_CRAWLER_SMOKE=1 PAPER_PILOT_BROWSER_SMOKE=1 vitest run tests/crawler-smoke.test.ts --testTimeout=240000",
    "test:crawlers:api": "cross-env PAPER_PILOT_LIVE_CRAWLER_SMOKE=1 vitest run tests/crawler-smoke.test.ts --testTimeout=120000",
    "test:crawlers:browser": "cross-env PAPER_PILOT_BROWSER_SMOKE=1 vitest run tests/crawler-smoke.test.ts --testTimeout=240000",
    "start": "electron .",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.2",
    "framer-motion": "^12.23.24",
    "jotai": "^2.15.1",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "42.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.0.16",
    "wait-on": "^9.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
